# Merge as a new virtual host only; never overwrite existing server blocks.
# Replace certificate paths with the certificates issued for this domain.
server {
    listen 80;
    server_name maopian.migucomi.com;
    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name maopian.migucomi.com;
    ssl_certificate /etc/letsencrypt/live/maopian.migucomi.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/maopian.migucomi.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 2048m;
    location / {
        proxy_pass http://127.0.0.1:8776;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_request_buffering off;
    }
}
